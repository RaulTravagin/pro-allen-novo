# Copie este arquivo para .env e substitua todos os valores de exemplo.
# O arquivo .env não deve ser enviado para repositórios ou para o ZIP compartilhável.

# Execução mínima com login local de Supervisores e Gestor
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/BANCO
JWT_SECRET=substitua-por-uma-chave-aleatoria-longa
GESTOR_ACCESS_PASSWORD=defina-uma-senha-forte-do-gestor
INITIAL_SUPERVISOR_PASSWORD=defina-uma-senha-inicial
RAULTRAVAGIN_INITIAL_PASSWORD=defina-uma-senha-inicial
VITE_APP_TITLE=Pro Allen

# Opcional: integração OAuth originalmente usada na plataforma de desenvolvimento.
# O login local de Supervisor e Gestor funciona sem estas variáveis.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Opcional: necessário apenas se o novo servidor usar armazenamento, mapas
# ou demais serviços Forge/Manus já presentes no código.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
