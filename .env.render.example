GESTOR_ACCESS_PASSWORD=defina-a-senha-do-gestor
INITIAL_SUPERVISOR_PASSWORD=defina-a-senha-inicial-de-paulo-rodrigo-e-aparecido
RAULTRAVAGIN_INITIAL_PASSWORD=defina-a-senha-inicial-de-raultravagin
INITIAL_RH_PASSWORD=defina-uma-senha-forte-para-rh-proallen
INITIAL_FINANCEIRO_PASSWORD=defina-uma-senha-forte-para-financeiro-proallen
INITIAL_ADMIN_PASSWORD=defina-uma-senha-forte-para-admin-proallen
